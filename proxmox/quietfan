#!/usr/bin/python3
"""Quiet chassis fans on Check Point 16200 hardware running Proxmox/Debian.

Loads NCT7904 PWM in manual mode and follows CPU package temperature.
"""
import glob
import os
import sys
import time

CURVE = [
    (50, 25),
    (58, 32),
    (63, 45),
    (68, 60),
    (73, 85),
    (78, 130),
    (85, 200),
    (92, 255),
]
MINPWM = 20
INTERVAL = 4
HYST = 2.0
MANUAL_ENABLE = 1  # pwmN_enable: 1=manual, 2=SmartFan


def read_int(path):
    try:
        return int(open(path).read().strip())
    except Exception:
        return None


def write_int(path, value):
    try:
        with open(path, "w") as f:
            f.write("%d\n" % value)
        return True
    except Exception:
        return False


def hwmon_by_name(name):
    for base in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            if open(os.path.join(base, "name")).read().strip() == name:
                return base
        except Exception:
            pass
    return None


def cpu_temp():
    vals = []
    for base in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            if open(os.path.join(base, "name")).read().strip() != "coretemp":
                continue
        except Exception:
            continue
        for lab in glob.glob(os.path.join(base, "temp*_label")):
            try:
                if not open(lab).read().strip().startswith("Package id"):
                    continue
                v = read_int(lab.replace("_label", "_input"))
                if v and v > 0:
                    vals.append(v / 1000.0)
            except Exception:
                pass
    if vals:
        return max(vals)
    nct = hwmon_by_name("nct7904")
    if nct:
        for n in ("temp6_input", "temp7_input"):
            v = read_int(os.path.join(nct, n))
            if v and v > 0:
                vals.append(v / 1000.0)
    return max(vals) if vals else None


def pwm_for(t):
    if t <= CURVE[0][0]:
        return CURVE[0][1]
    if t >= CURVE[-1][0]:
        return CURVE[-1][1]
    for i in range(1, len(CURVE)):
        t0, p0 = CURVE[i - 1]
        t1, p1 = CURVE[i]
        if t <= t1:
            return int(p0 + (t - t0) / float(t1 - t0) * (p1 - p0))
    return CURVE[-1][1]


def set_pwm(nct, p):
    p = max(MINPWM, min(255, int(p)))
    for i in range(1, 5):
        write_int(os.path.join(nct, "pwm%d_enable" % i), MANUAL_ENABLE)
        path = os.path.join(nct, "pwm%d" % i)
        write_int(path, p)
        write_int(path, p)
    return p


def wait_hw():
    for _ in range(90):
        nct = hwmon_by_name("nct7904")
        if nct and os.path.exists(os.path.join(nct, "pwm1")):
            return nct
        time.sleep(1)
    sys.stderr.write("quietfan: no nct7904 pwm\n")
    sys.exit(1)


def main():
    nct = wait_hw()
    cur = None
    last_t = None
    while True:
        t = cpu_temp()
        if t is None:
            time.sleep(INTERVAL)
            continue
        tgt = pwm_for(t)
        if cur is not None and tgt < cur and last_t is not None and t > last_t - HYST:
            tgt = cur
        if cur != tgt:
            cur = set_pwm(nct, tgt)
            last_t = t
            print("quietfan: temp=%.1fC pwm=%d" % (t, cur), flush=True)
        time.sleep(INTERVAL)


if __name__ == "__main__":
    main()
